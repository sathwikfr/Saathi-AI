datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  phone         String?
  avatar        String?
  passwordHash  String?
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastSeenAt    DateTime? // last dashboard visit (weekly-active families metric)

  subscription            UserSubscription?
  notificationPreferences NotificationPreferences?
  sessions                DBSession[]
  parents                 ParentProfile[]
  invoices                Invoice[]
  medicineReports         MedicineReport[]
  emailLogs               EmailLog[]
  whatsappMessages        WhatsAppMessage[]
}

model DBSession {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  rememberMe Boolean  @default(true)
  revoked    Boolean  @default(false)

  @@index([userId])
}

model OTPRecord {
  id        String   @id @default(uuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  purpose   String   @default("login")
  createdAt DateTime @default(now())

  @@index([phone])
}

model PasswordResetRecord {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model OAuthAccount {
  id        String   @id @default(uuid())
  userId    String
  provider  String   @default("google")
  email     String
  createdAt DateTime @default(now())

  @@index([userId])
}

model UserSubscription {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                 String    @default("family")
  status                 String    @default("trialing") // trialing, active, past_due, cancelled, free
  startDate              DateTime  @default(now())
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean   @default(false)
  amount                 Int       @default(1299)
  paymentMethodLast4     String?
  paymentMethodBrand     String?
  razorpaySubscriptionId String?
  razorpayPaymentId      String?
  cancelReason           String? // asked when the customer cancels
  cancelledAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model Invoice {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceNumber String
  date          String
  amount        Int
  planName      String
  status        String   @default("paid")
  downloadUrl   String?
  paymentMethod String
  createdAt     DateTime @default(now())

  @@index([userId])
}

model ParentProfile {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  phone        String
  language     String    @default("Hindi & English")
  timezone     String    @default("Asia/Kolkata (IST)")
  callTime     String    @default("09:00 AM")
  isPaused     Boolean   @default(false)
  pauseReason  String?
  pauseUntil   DateTime?
  consentGiven Boolean   @default(true)
  consentDate  DateTime  @default(now())
  isDeleted    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // The parent's OWN consent, asked by Saathi on the first call (consentGiven above is the family's confirmation).
  parentConsent       String? // null/pending | given | declined | withdrawn
  parentConsentAt     DateTime?
  parentConsentCallId String?

  // Emergency card (shared with neighbours / hospital through cardToken)
  address         String?
  livesAlone      Boolean @default(false)
  bloodGroup      String?
  conditions      String?
  allergies       String?
  nearestHospital String?
  doctorName      String?
  doctorPhone     String?
  cardToken       String? @unique // null = card not shared

  // Trust set-up and call rhythm
  introducedAt      DateTime? // family introduced Saathi to the parent
  numberSavedAt     DateTime? // Saathi's number saved on the parent's phone
  lastSafetyLineAt  DateTime? // "I will never ask for money or OTPs"
  lastWellbeingAt   DateTime? // sleep / appetite / pain questions
  lastRefillCheckAt DateTime?
  birthDate         String? // MM-DD, for a birthday wish

  // Weekly companion call (opt-in, paid plans)
  companionEnabled Boolean   @default(false)
  companionDay     Int? // 0 = Sunday … 6 = Saturday (IST)
  companionTime    String? // "05:00 PM" IST
  companionTopics  String? // family-written interests
  lastCompanionAt  DateTime?

  callSchedule      ScheduledCallSlot[]
  medicines         Medicine[]
  emergencyContacts EmergencyContact[]
  callLogs          CallLog[]
  alerts            AlertRecord[]
  suggestions       ScheduleSuggestion[]
  caregivers        CaregiverInvite[]
  medicineReports   MedicineReport[]
  escalations       Escalation[]
  insights          HealthInsight[]
  documents         HealthDocument[]

  @@index([userId])
}

model ScheduledCallSlot {
  id                  String        @id @default(uuid())
  parentId            String
  parent              ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  time                String
  slot                String // morning, afternoon, evening, bedtime, wellness, custom
  label               String
  linkedMedicineNames String[]
  linkedMedicinesJson String? // Serialized JSON for LinkedMedicineDetail[]
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())

  @@index([parentId])
}

model Medicine {
  id           String        @id @default(uuid())
  parentId     String
  parent       ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  name         String
  dosage       String
  timeOfDay    String        @default("morning")
  timingSlots  String[]
  foodRelation String        @default("not_specified")
  frequency    String        @default("daily")
  isActive     Boolean       @default(true)
  purpose      String? // the family's one-line reason ("keeps your BP steady"); Saathi repeats it, never invents one
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([parentId])
}

model EmergencyContact {
  id        String        @id @default(uuid())
  parentId  String
  parent    ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  name      String
  relation  String
  phone     String
  priority  String        @default("primary")
  createdAt DateTime      @default(now())

  role           String? // family | neighbour | security | doctor | caregiver | other
  isLocal        Boolean   @default(false) // lives near the parent and can go there
  practiceAt     DateTime? // answered a practice alert call
  practiceResult String? // yes | no | unclear | no_answer

  @@index([parentId])
}

model CallLog {
  id                  String        @id @default(uuid())
  parentId            String
  parent              ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  scheduledTime       String
  actualAnswerTime    String?
  status              String        @default("scheduled")
  durationSeconds     Int           @default(0)
  medicationConfirmed Boolean       @default(false)
  mood                String        @default("cheerful")
  summary             String
  notes               String?
  createdAt           DateTime      @default(now())

  // Voice-call tracking (all optional so existing rows are untouched)
  slotId            String?
  slot              String?
  callDate          String? // IST calendar date, YYYY-MM-DD
  attemptNumber     Int       @default(1)
  providerAttemptId String?   @unique // Sarvam attempt_id
  interactionId     String?
  failureReason     String?
  transcriptJson    String?
  resultJson        String?
  startedAt         DateTime?
  endedAt           DateTime?
  nextRetryAt       DateTime?
  processedAt       DateTime? // set once the end-of-call result has been applied (webhook idempotency)
  followUpAt        DateTime? // parent said "later": one follow-up call about those medicines (claimed by clearing it)
  parentWords       Int? // words the parent spoke (kept after transcripts are cleared, for the "shorter answers" trend)

  @@unique([parentId, slotId, callDate, attemptNumber])
  @@index([parentId])
  @@index([status, nextRetryAt])
}

model AlertRecord {
  id             String        @id @default(uuid())
  parentId       String
  parent         ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  level          Int           @default(1)
  title          String
  message        String
  channel        String        @default("whatsapp")
  timestamp      String
  status         String        @default("sent")
  createdAt      DateTime      @default(now())
  callLogId      String? // call that raised this alert (dedupe + traceability)
  acknowledgedAt DateTime? // family tapped "I'll handle it" on WhatsApp

  handledByName String? // who said "I'm on it"
  handledVia    String? // whatsapp | call | dashboard
  outcome       String? // fine | doctor_visit | hospital | other (recorded afterwards; closes the alert)
  outcomeNote   String?
  outcomeAt     DateTime?
  outcomeById   String?

  @@index([parentId])
}

model ScheduleSuggestion {
  id              String        @id @default(uuid())
  parentId        String
  parent          ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  currentCallTime String
  suggestedTime   String
  confidencePct   Int           @default(90)
  sampleSize      Int           @default(7)
  reason          String
  status          String        @default("pending")
  createdAt       DateTime      @default(now())

  @@index([parentId])
}

model CaregiverInvite {
  id        String        @id @default(uuid())
  parentId  String
  parent    ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  email     String // "" when invited by link without an email
  name      String
  role      String        @default("viewer")
  status    String        @default("pending") // pending | accepted | revoked
  invitedAt DateTime      @default(now())

  // Family circle: an accepted invite gives this account access to the parent.
  userId      String?
  token       String?   @unique // invite link token (cleared once accepted)
  phone       String?
  invitedById String?
  acceptedAt  DateTime?
  revokedAt   DateTime?

  @@index([parentId])
  @@index([userId])
}

model NotificationPreferences {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsapp          Boolean   @default(true)
  sms               Boolean   @default(true)
  email             Boolean   @default(true)
  push              Boolean   @default(false)
  minimumAlertLevel Int       @default(1)
  whatsappNumber    String? // E.164; null = use the account phone
  whatsappOptInAt   DateTime? // explicit opt-in (Meta requires it); null = not opted in
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  timezone         String? // IANA, e.g. "America/New_York"; null = Asia/Kolkata
  dailySummary     Boolean @default(false) // routine call results batched into one message a day
  dailySummaryHour Int     @default(20) // local hour (0-23) in `timezone`
  weeklyDigest     Boolean @default(true)
  digestDay        Int     @default(0) // 0 = Sunday
  digestHour       Int     @default(9)
  monthlySummary   Boolean @default(true)
  wakeForEmergency Boolean @default(true) // phone call (not only WhatsApp) for level-4 alerts
  emergencyPhone   String? // E.164 number to ring for level 4; null = account phone
}

model MedicineReport {
  id                   String         @id @default(uuid())
  parentId             String?
  parent               ParentProfile? @relation(fields: [parentId], references: [id], onDelete: SetNull)
  userId               String?
  user                 User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  fileName             String
  fileType             String
  fileUrl              String?
  uploadedAt           DateTime       @default(now())
  rawExtractionJson    String // JSON text
  batchConfidence      String?
  batchQualityWarning  String?
  confirmedAt          DateTime?
  confirmedMedicineIds String[]
  status               String         @default("draft")

  @@index([parentId])
  @@index([userId])
}

/// One row per transactional email that must be sent at most once (trial reminders, receipts,
/// cancellation notices). The unique key is what makes retried webhooks and repeated cron runs safe.
model EmailLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  refKey    String
  createdAt DateTime @default(now())

  @@unique([userId, kind, refKey])
  @@index([userId])
}

/// Every WhatsApp message sent or received. The (kind, refKey) pair makes each
/// family notification once-only (e.g. one call update per call per number).
model WhatsAppMessage {
  id                String    @id @default(uuid())
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  parentId          String?
  callLogId         String?
  alertId           String? // the alert the buttons act on ("I'll handle it")
  direction         String    @default("out") // out | in
  kind              String // call_update | attention | emergency | reply | auto_reply | inbound
  refKey            String
  phone             String // the family's number, E.164
  templateName      String?
  body              String
  level             Int       @default(0) // highest alert level in the message
  providerMessageId String?   @unique
  status            String    @default("pending") // pending | sent | delivered | read | failed | received
  error             String?
  fallbackEmailedAt DateTime? // level 3-4 message that failed and was emailed instead
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([kind, refKey])
  @@index([userId])
  @@index([phone])
}

/// One emergency (level-4 alert), wellness check ("lives alone" parent unreachable) or practice alert,
/// worked through a ladder of people who can act until someone says "I'm on it".
model Escalation {
  id             String        @id @default(uuid())
  parentId       String
  parent         ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  alertId        String?       @unique // the AlertRecord this escalates (null for practice alerts)
  kind           String // emergency | wellness_check | practice
  reason         String
  status         String        @default("active") // active | handled | exhausted | closed
  round          Int           @default(0) // ladder round reached
  nextStepAt     DateTime? // when the next round is due if nobody has responded
  handledByName  String?
  handledByPhone String?
  handledVia     String? // whatsapp | call | dashboard
  handledAt      DateTime?
  closedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  attempts EscalationAttempt[]

  @@index([parentId])
  @@index([status, nextStepAt])
}

/// One call or message in an escalation (to the family, a local contact, or the parent again).
model EscalationAttempt {
  id                String     @id @default(uuid())
  escalationId      String
  escalation        Escalation @relation(fields: [escalationId], references: [id], onDelete: Cascade)
  round             Int
  targetType        String // owner | member | contact | parent
  targetId          String? // user / EmergencyContact / parent id
  name              String
  phone             String
  channel           String // call | whatsapp
  providerAttemptId String?    @unique // Sarvam attempt id for calls
  status            String     @default("pending") // pending | placed | answered | no_answer | busy | failed | sent
  response          String? // yes | no | unclear
  failureReason     String?
  createdAt         DateTime   @default(now())
  respondedAt       DateTime?

  @@index([escalationId])
}

/// A pattern noticed across several calls (never a diagnosis). Once per kind and subject per parent per week.
model HealthInsight {
  id          String        @id @default(uuid())
  parentId    String
  parent      ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  kind        String // repeat_complaint | low_mood | shorter_answers | missed_calls | adherence_drop | poor_sleep | poor_appetite | pain
  refKey      String // ISO week (+ subject), e.g. "2026-W40:knee"
  level       Int           @default(1)
  title       String
  message     String
  evidence    String? // JSON: [{ callLogId, date, text }]
  createdAt   DateTime      @default(now())
  dismissedAt DateTime?

  @@unique([parentId, kind, refKey])
  @@index([parentId])
}

/// A file in a parent's health record vault. The file itself is in a private Supabase Storage bucket.
model HealthDocument {
  id           String        @id @default(uuid())
  parentId     String
  parent       ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  uploadedById String
  kind         String // prescription | lab_report | scan | bill | discharge | insurance | other
  title        String
  docDate      String? // YYYY-MM-DD the document is from
  renewalDate  String? // YYYY-MM-DD (insurance policies), shown as a reminder
  notes        String?
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String        @unique
  isDeleted    Boolean       @default(false)
  createdAt    DateTime      @default(now())

  @@index([parentId])
}
